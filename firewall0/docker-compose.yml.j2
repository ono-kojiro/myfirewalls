---
services:
{% for item in terminals %}
  {{ item.name }}:
    image: ${IMAGE}
    container_name: {{ item.name }}
    hostname: {{ item.name }}
    restart: always
    stdin_open: true
    tty: true

    cap_add:
    - NET_ADMIN

    environment:
      TZ: Asia/Tokyo
      LDAP_URI: ${LDAP_URI}
      LDAP_BASE: ${LDAP_BASE}
      LDAP_START_TLS: ${LDAP_START_TLS}
      LDAP_TLS_REQCERT: ${LDAP_TLS_REQCERT}
      LDAP_ALLOW_GROUPS: ${LDAP_ALLOW_GROUPS}

    networks:
      - {{ item.bridge }}

{% endfor %}

networks:
{% for item in terminals %}
  {{ item.bridge }}:
    external: true
{% endfor %}

