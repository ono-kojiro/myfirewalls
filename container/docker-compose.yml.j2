---
services:
{% for id in terminals %}
  terminal{{ id }}:
    image: ${IMAGE}
    container_name: terminal{{ id }}
    hostname: terminal{{ id }}
    restart: always
    stdin_open: true
    tty: true
    
    networks:
      br{{ id }}:
        ipv4_address: 172.16.{{ id }}.1{{ id }}

    cap_add:
    - NET_ADMIN

    environment:
      TZ: Asia/Tokyo
      LDAP_URI: ${LDAP_URI}
      LDAP_BASE: ${LDAP_BASE}
      LDAP_START_TLS: ${LDAP_START_TLS}
      LDAP_TLS_REQCERT: ${LDAP_TLS_REQCERT}
      LDAP_ALLOW_GROUPS: ${LDAP_ALLOW_GROUPS}

{% endfor %}

networks:
{% for id in terminals %}
  br{{ id }}:
    external: true
{% endfor %}

